generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts          Account[]
  groupMemberships  GroupMember[]
  paidExpenses      Expense[]        @relation("PaidBy")
  expenseSplits     ExpenseSplit[]
  sentSettlements   Settlement[]      @relation("SentBy")
  receivedSettlements Settlement[]    @relation("ReceivedBy")
  activities        Activity[]        @relation("User")
  createdGroups     Group[]           @relation("GroupCreator")
  sessions          Session[]
  sentInvites      Invite[]           @relation("Inviter")
  receivedInvites  Invite[]           @relation("Invitee")
  sentFriendRequests  Friendship[]     @relation("Requester")
  receivedFriendRequests Friendship[]   @relation("Addressee")
  nonUserSplits   NonUserSplit[]      @relation("NonUserSplitLink")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  emoji       String   @default("💰")
  currency    String   @default("INR")
  category    String   @default("general")
  inviteCode  String   @unique @default(cuid())
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members    GroupMember[]
  expenses   Expense[]
  settlements Settlement[]

  creator    User      @relation("GroupCreator", fields: [createdBy], references: [id])
  activities Activity[]
  invites    Invite[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("member")
  nickname  String?
  joinedAt  DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Expense {
  id          String   @id @default(cuid())
  groupId     String?
  description String
  amount      Float
  category    String   @default("other")
  splitType   String   @default("equal")
  note        String?
  receiptUrl  String?
  isRecurring Boolean  @default(false)
  recurringFrequency String?
  date        DateTime @default(now())
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group      Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy     User           @relation("PaidBy", fields: [createdBy], references: [id])
  splits     ExpenseSplit[]
  nonUserSplits NonUserSplit[]
  settlements Settlement[]
}

model ExpenseSplit {
  id        String  @id @default(cuid())
  expenseId String
  userId    String
  amount    Float
  percentage Float?
  share     Float  @default(1)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

model NonUserSplit {
  id        String  @id @default(cuid())
  expenseId String
  email     String
  name      String?
  amount    Float
  percentage Float?
  share     Float  @default(1)
  linkedUserId String?
  createdAt DateTime @default(now())

  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  linkedUser  User?    @relation("NonUserSplitLink", fields: [linkedUserId], references: [id], onDelete: SetNull)

  @@unique([expenseId, email])
}

model Settlement {
  id          String   @id @default(cuid())
  groupId     String?
  fromUserId  String
  toUserId    String
  amount      Float
  note        String?
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  group     Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser  User   @relation("SentBy", fields: [fromUserId], references: [id])
  toUser    User   @relation("ReceivedBy", fields: [toUserId], references: [id])
  expenses  Expense[]
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  groupId   String?
  type      String
  message   String
  metadata  String?
  createdAt DateTime @default(now())

  user  User   @relation("User", fields: [userId], references: [id], onDelete: Cascade)
  group Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
}

model BalanceCache {
  id        String  @id @default(cuid())
  fromUserId String
  toUserId   String
  groupId   String?
  amount    Float

  @@unique([fromUserId, toUserId, groupId])
}

model Invite {
  id        String   @id @default(cuid())
  code      String   @unique
  groupId   String
  inviterId String
  inviteeEmail String
  inviteeId String?
  status    String   @default("pending")
  role      String   @default("member")
  expiresAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User  @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User? @relation("Invitee", fields: [inviteeId], references: [id], onDelete: SetNull)
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}