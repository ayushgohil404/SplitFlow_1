# ============================================
# SplitFlow - Environment Configuration
# ============================================
# Copy this file as ".env" and fill in your values.
#   cp .env.example .env
#
# Then add these same variables in:
#   Vercel → Project → Settings → Environment Variables
# ============================================

# --------------------------------------------------
# REQUIRED: NextAuth Secret (signs JWT session tokens)
# --------------------------------------------------
# Generate one here: https://generate-secret.vercel.app/32
# Or run in terminal: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# --------------------------------------------------
# Your app's public URL (used for OAuth redirects)
# --------------------------------------------------
NEXTAUTH_URL=https://splitflow-1.vercel.app

# ============================================
# GITHUB OAUTH
# ============================================
# Step 1: Go to → https://github.com/settings/developers
# Step 2: Click "New OAuth App"
# Step 3: Fill in:
#   - Application name:           SplitFlow
#   - Homepage URL:               https://splitflow-1.vercel.app
#   - Authorization callback URL: https://splitflow-1.vercel.app/api/auth/callback/github
# Step 4: Click "Register application"
# Step 5: Click "Generate a new client secret"
# Step 6: Copy Client ID → GITHUB_ID, Client Secret → GITHUB_SECRET
# ============================================
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# ============================================
# GOOGLE OAUTH
# ============================================
# Step 1: Go to → https://console.cloud.google.com/
# Step 2: Create a project → APIs & Services → OAuth consent screen (External)
# Step 3: Add scopes: email, profile. Add your email as test user.
# Step 4: APIs & Services → Credentials → Create Credentials → OAuth client ID
#   - Application type:              Web application
#   - Name:                          SplitFlow
#   - Authorized JavaScript origins: https://splitflow-1.vercel.app
#   - Authorized redirect URIs:      https://splitflow-1.vercel.app/api/auth/callback/google
# Step 5: Copy Client ID → GOOGLE_ID, Client Secret → GOOGLE_SECRET
# ============================================
GOOGLE_ID=your-google-client-id
GOOGLE_SECRET=your-google-client-secret

# ============================================
# DATABASE (Render - Free PostgreSQL)
# ============================================
# Step 1: Go to → https://dashboard.render.com
# Step 2: Sign up with GitHub (free)
# Step 3: Click "New" → "PostgreSQL"
# Step 4: Fill in:
#   - Name:          splitflow-db
#   - Database:      splitflow
#   - User:          (leave default)
#   - Region:        closest to you
#   - PostgreSQL Version: latest
# Step 5: Click "Create Free Database" (takes ~2 min)
# Step 6: Go to your database → "Connect" → "External Connection"
#   - Copy the full connection string (starts with postgres://...)
#   - Paste it as DATABASE_URL below
# Step 7: Run migration locally:
#   DATABASE_URL="postgres://..." npx prisma db push
#
# NOTE: Free tier has 90MB storage, auto-pauses after 90 days inactivity
# ============================================
DATABASE_URL=postgres://splitflow_user:password@host:5432/splitflow

# ============================================
# AI - Groq (Free, fast AI for expense parsing & insights)
# ============================================
# Step 1: Go to → https://console.groq.com
# Step 2: Sign up (free with Google/GitHub)
# Step 3: Go to → https://console.groq.com/keys
# Step 4: Click "Create API Key" → copy it
# Step 5: Paste it as GROQ_API_KEY below
#
# Free tier: 30 requests/min, 14,400 requests/day
# Used for: Smart expense parsing, AI categorization,
#          Receipt scanning, Spending insights & analysis
# ============================================
GROQ_API_KEY=your-groq-api-key
