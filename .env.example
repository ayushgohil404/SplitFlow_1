# ============================================
# SplitFlow - OAuth Configuration
# ============================================
# Copy this file as ".env" and fill in your values.
#   cp .env.example .env
#
# After setting up, restart your app.
# ============================================

# --------------------------------------------------
# REQUIRED: NextAuth Secret (used to sign JWT tokens)
# --------------------------------------------------
# Generate one here: https://generate-secret.vercel.app/32
# Or run in terminal: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# --------------------------------------------------
# Your app's public URL (needed for OAuth redirects)
# --------------------------------------------------
NEXTAUTH_URL=https://splitflow.space-z.ai

# ============================================
# GITHUB OAUTH
# ============================================
# Step 1: Go to → https://github.com/settings/developers
# Step 2: Click "New OAuth App"
# Step 3: Fill in:
#   - Application name:           SplitFlow
#   - Homepage URL:               https://splitflow.space-z.ai
#   - Authorization callback URL: https://splitflow.space-z.ai/api/auth/callback/github
# Step 4: Click "Register application"
# Step 5: Click "Generate a new client secret"
# Step 6: Copy Client ID → GITHUB_ID, Client Secret → GITHUB_SECRET
# ============================================
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# ============================================
# GOOGLE OAUTH
# ============================================
# Step 1: Go to → https://console.cloud.google.com/
# Step 2: Create a project → APIs & Services → OAuth consent screen (External)
# Step 3: Add scopes: email, profile. Add your email as test user.
# Step 4: APIs & Services → Credentials → Create Credentials → OAuth client ID
#   - Application type:            Web application
#   - Name:                        SplitFlow
#   - Authorized JavaScript origins: https://splitflow.space-z.ai
#   - Authorized redirect URIs:    https://splitflow.space-z.ai/api/auth/callback/google
# Step 5: Copy Client ID → GOOGLE_ID, Client Secret → GOOGLE_SECRET
# ============================================
GOOGLE_ID=your-google-client-id
GOOGLE_SECRET=your-google-client-secret

# ============================================
# DATABASE (SQLite - no config needed)
# ============================================
# DB file is at: prisma/custom.db
# ============================================
